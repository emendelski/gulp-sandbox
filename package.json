    "cssnano": "^9.9.0",
    "del": "^9.0.1",
    "esbuild": "^0.28.2",
    "gulp": "^5.0.1",
    "gulp-changed": "^5.0.4",
    "gulp-cli": "^3.1.0",
    "gulp-esbuild": "^0.15.0",
    "gulp-imagemin": "^9.2.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "postcss": "^8.5.33",
    "sass-embedded": "^1.108.2"
