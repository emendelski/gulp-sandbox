{
  "name": "gulp-sandbox",
  "description": "Gulp sandbox for HTML, SCSS and JavaScript",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "author": "Kamil Mendelski (https://frontlabs.pl)",
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "gulp",
    "build": "gulp build",
    "clean": "gulp clean",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "autoprefixer": "^10.7.0",
    "bootstrap": "^5.3.9",
    "browser-sync": "^3.0.4",
    "cssnano": "^9.9.0",
    "del": "^9.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "gulp": "^5.0.1",
    "gulp-changed": "^5.0.4",
    "gulp-cli": "^3.1.0",
    "gulp-esbuild": "^0.15.0",
    "gulp-imagemin": "^9.2.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "gifsicle": true,
    "mozjpeg": true,
    "optipng-bin": true,
    "fsevents": false
  }
}
